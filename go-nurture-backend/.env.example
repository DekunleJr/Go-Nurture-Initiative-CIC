# Backend Environment Variables
# Copy this file to .env and update values for your environment
# NEVER commit this file with real values to version control

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/go_nurture
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# JWT & Security (REQUIRED)
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000

# Email Configuration (optional for development)
# Set RESEND_API_KEY to enable email sending, leave blank to use console fallback
RESEND_API_KEY=

# Initial Admin Account Setup (optional)
# These are used to seed an initial admin user on first startup
ADMIN_EMAIL=admin@gonitiate.org
ADMIN_PASSWORD=change-me-in-production

# Application Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
