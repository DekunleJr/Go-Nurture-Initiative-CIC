# {$DOMAIN} comes from .env via docker-compose. Caddy obtains and renews the
# Let's Encrypt certificate automatically once DNS points at this server.
{$DOMAIN} {
	encode gzip zstd

	# API goes to FastAPI; everything else to Next.js. Same origin => the
	# httpOnly auth cookie is first-party.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
