# Copy to `.env` on the server (next to docker-compose.yml). NEVER commit .env.

# Domain pointing (A record) at the Krystal VM's public IP, no https://
DOMAIN=www.example.org

# Generate: openssl rand -hex 24   (hex only, so it is safe inside the DB URL)
POSTGRES_PASSWORD=
# Generate: openssl rand -hex 32
SECRET_KEY=

# Seeds the first admin user on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Resend) - optional but needed for real emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# Stripe donations - optional
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry - optional
NEXT_PUBLIC_SENTRY_DSN=
